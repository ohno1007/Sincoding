// guardian.sin —— 完整小游戏「家园守护者」（正经结构版）
//
// 用 Faller 结构体数组取代原先 4 个平行全局数组（ix/iy/ikind/handles）：
// 一个下落物的完整状态聚成一个结构体，逻辑用「取出→改→放回」的值语义处理，
// 并把重置/接住判定抽成接收/返回结构体的函数。这是「敌人列表」的正经写法。
//
// 角色外观用造型 PNG（sprite_load 当纹理）：金币 coin.png、炸弹 bomb.png、
// 挡板 paddle.png（tools/make_costumes.py 生成；APK 打包随 assets 入包）。
//
// 玩法：方向键左右移动挡板。接金币(+1分)、躲炸弹(-1命)。每 5 分升级，下落变快。
// 命数耗尽则结束。综合用到：结构体、结构体数组、结构体作参数/返回值（值语义）、
// 全局单例状态、for 循环、int↔float 转换、键盘输入、计分。

extern fn stage_init(w: int, h: int)
extern fn stage_running() -> bool
extern fn frame_begin()
extern fn frame_end()
extern fn stage_close()
extern fn sprite_load(path: string) -> int
extern fn sprite_move_to(s: int, x: float, y: float)
extern fn sprite_draw(s: int)
extern fn key_down(key: int) -> bool
extern fn key_left() -> int
extern fn key_right() -> int
extern fn draw_text(text: string, x: float, y: float, size: int)
extern fn draw_number(n: int, x: float, y: float, size: int)
extern fn play_tone(freq: int, ms: int)
extern fn to_float(n: int) -> float
extern fn to_int(f: float) -> int

struct GameState { score: int, lives: int, level: int }

struct Faller {
    x: float,
    y: float,
    kind: int,        // 0=金币 1=炸弹
    handle: int
}

let game: GameState
let N = 6
let fallers: Faller[6]        // 结构体数组：取代 4 个平行全局数组
let px = 0.0
let paddle = 0

fn abs_f(v: float) -> float {
    if v < 0.0 { return 0.0 - v }
    return v
}

fn spawn_x(seed: int) -> float {
    let m = seed * 53 + 17
    let col = m - (m / 7) * 7
    return to_float(col) * 70.0 - 210.0
}

// 结构体作参数 + 返回值：重置一个下落物到顶部（值语义，返回新值）
fn respawn(f: Faller, seed: int) -> Faller {
    f.x = spawn_x(seed)
    f.y = 280.0
    return f
}

// 结构体作参数：是否被挡板接住
fn caught(f: Faller, px: float) -> bool {
    return abs_f(f.x - px) < 60.0
}

fn main() -> int {
    stage_init(800, 600)
    game.score = 0
    game.lives = 3
    game.level = 1

    for i in 0..N {
        let f: Faller
        let r = i - (i / 3) * 3
        if r == 2 {
            f.kind = 1
            f.handle = sprite_load("bomb.png")
        }
        if r != 2 {
            f.kind = 0
            f.handle = sprite_load("coin.png")
        }
        f = respawn(f, game.score + i * 3 + game.level)
        f.y = to_float(i) * 90.0 - 100.0
        fallers[i] = f
    }

    paddle = sprite_load("paddle.png")
    px = 0.0

    while stage_running() {
        if key_down(key_left()) { px = px - 15.0 }
        if key_down(key_right()) { px = px + 15.0 }
        if px < -360.0 { px = -360.0 }
        if px > 360.0 { px = 360.0 }
        sprite_move_to(paddle, px, -250.0)

        let fall = 4.0 + to_float(game.level) * 1.5

        for i in 0..N {
            let f = fallers[i]            // 取出（值拷贝）
            f.y = f.y - fall
            if f.y < -240.0 {
                if caught(f, px) {
                    if f.kind == 0 {
                        game.score = game.score + 1
                        play_tone(880, 40)
                        if game.score - (game.score / 5) * 5 == 0 {
                            game.level = game.level + 1
                        }
                    }
                    if f.kind == 1 {
                        game.lives = game.lives - 1
                        play_tone(160, 90)
                    }
                }
                f = respawn(f, game.score + i * 3 + game.level)
            }
            sprite_move_to(f.handle, f.x, f.y)
            fallers[i] = f               // 放回
        }

        frame_begin()
        for i in 0..N {
            sprite_draw(fallers[i].handle)
        }
        sprite_draw(paddle)
        draw_text("Score:", -380.0, 270.0, 26)
        draw_number(game.score, -250.0, 270.0, 26)
        draw_text("Lives:", -380.0, 235.0, 26)
        draw_number(game.lives, -250.0, 235.0, 26)
        draw_text("Lv:", 250.0, 270.0, 26)
        draw_number(game.level, 320.0, 270.0, 26)
        frame_end()

        if game.lives <= 0 { stage_close() }
    }

    stage_close()
    print(game.score)
    return 0
}
